# EmailJS Configuration (Recommended for direct browser email delivery)
# 1. Sign up for free at https://www.emailjs.com/
# 2. Add Email Service (e.g. Gmail) -> Copy Service ID
# 3. Create Email Template with variables {{to_email}}, {{subject}}, {{message}} -> Copy Template ID
# 4. In Account Settings > API Keys -> Copy Public Key
VITE_EMAILJS_SERVICE_ID="your_service_id_here"
VITE_EMAILJS_TEMPLATE_ID="your_template_id_here"
VITE_EMAILJS_PUBLIC_KEY="your_public_key_here"
VITE_TO_EMAIL="harshitkurtakoti@gmail.com"

# Backend configuration (Optional Express Server)
VITE_BACKEND_URL="/api/notify"
NOTIFICATION_EMAIL="harshitkurtakoti@gmail.com"
PORT=5000
RESEND_API_KEY=""
WHATSAPP_ACCESS_TOKEN=""
